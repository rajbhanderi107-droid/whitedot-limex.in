# WHITE DOT LIMEX — Environment Variables Example
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to GitHub.

# Backend (set these on the VPS in /etc/whitedot-backend/.env or your Docker env)
JWT_SECRET=your_jwt_secret_here_min_32_chars
FRONTEND_URL=https://whitedotindia.in
FRONTEND_ORIGINS=https://whitedotindia.in
ADMIN_INQUIRY_EMAIL=rajbhanderi107@gmail.com

# Outgoing mail (optional). If SMTP_HOST/USER/PASS are unset, password-reset
# emails are logged to the console instead of sent — safe for dev/preview.
# SMTP_FROM must be on a domain whose SPF authorises this server, or the mail
# will fail authentication. See docs/EMAIL_DNS.md before changing these.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true only for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@whitedotindia.in
GOOGLE_CLIENT_ID=               # optional
ANTHROPIC_API_KEY=              # optional, for AI Growth Studio
LLM_API_KEY=                    # optional, for LIMEX chatbot (Groq etc)

# Frontend (Vite - prefix with VITE_)
# Leave VITE_API_URL unset — hardcoded defaults in publicApi.ts:
#   dev  -> http://localhost:4000
#   prod -> https://api.whitedotindia.in  (also baked into deploy.yml)
VITE_API_URL=
VITE_APP_NAME=WhiteDot

# Google Analytics (GA4). Without it, no analytics script loads.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Premium / cinematic feature kill switches. All default ON when unset;
# set to "false" to disable a layer.
# VITE_WD_PREMIUM_ENABLED=true
# VITE_WD_AGGREGATION_ENABLED=true
# VITE_WD_CONTINUITY_ENABLED=true
# VITE_WD_GOD_ENABLED=true
# VITE_WD_HIGGSFIELD_ENABLED=true
# VITE_WD_ASSISTANT_ENABLED=true

# External APIs (never expose in frontend)
# CLAUDE_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
