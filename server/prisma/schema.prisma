generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  VIEWER
}

enum CompanyStatus {
  LEAD
  ACTIVE_CLIENT
  INACTIVE
  BLACKLISTED
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum QuoteStatus {
  NEW
  UNDER_REVIEW
  NEED_MORE_INFO
  QUOTED
  NEGOTIATION
  APPROVED
  REJECTED
  CLOSED
}

enum SampleStatus {
  REQUESTED
  APPROVED
  REJECTED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum DocumentCategory {
  BROCHURE
  TECHNICAL_DATASHEET
  SUSTAINABILITY_REPORT
  CASE_STUDY
  CLIENT_DOCUMENT
  INTERNAL
}

enum WebsiteSettingType {
  TEXT
  NUMBER
  BOOLEAN
  JSON
  URL
  EMAIL
}

enum ActivityEntityType {
  USER
  COMPANY
  INQUIRY
  QUOTE_REQUEST
  SAMPLE_REQUEST
  CALCULATOR_SUBMISSION
  DOCUMENT
  WEBSITE_SETTING
  PORTAL
  AUTOMATION
  APPROVAL
  WORKFLOW
  INCIDENT
  INTEGRATION
  AI_AGENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  LEAD
  QUOTE
  SAMPLE
  FOLLOW_UP
}

// ─── Models ──────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  assignedInquiries  Inquiry[]       @relation("AssignedInquiries")
  assignedQuotes     QuoteRequest[]  @relation("AssignedQuotes")
  createdNotes       AdminNote[]     @relation("NoteCreator")
  assignedFollowUps  FollowUpTask[]  @relation("AssignedFollowUps")
  uploadedDocuments  DocumentAsset[] @relation("DocumentUploader")
  updatedSettings    WebsiteSetting[] @relation("SettingUpdater")
  activityLogs       ActivityLog[]
  notifications      Notification[]
  passwordResets     PasswordResetToken[]
  approvalsCreated   ApprovalRequest[] @relation("ApprovalCreatedBy")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")

  @@index([email])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model Company {
  id            String        @id @default(cuid())
  companyName   String
  industry      String?
  contactPerson String?
  email         String?
  phone         String?
  website       String?
  city          String?
  state         String?
  country       String?       @default("India")
  address       String?
  gstNumber     String?
  status        CompanyStatus @default(LEAD)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  inquiries              Inquiry[]
  quoteRequests          QuoteRequest[]
  sampleRequests         SampleRequest[]
  calculatorSubmissions  CalculatorSubmission[]
  adminNotes             AdminNote[]
  followUpTasks          FollowUpTask[]
  documents              DocumentAsset[]

  @@index([email])
  @@index([status])
  @@index([companyName])
  @@index([createdAt])
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  companyName   String?
  designation   String?
  city          String?
  country       String?
  industry      String?
  inquiryType   String?
  message       String?
  sourcePage    String?
  status        InquiryStatus @default(NEW)
  priority      Priority      @default(MEDIUM)
  internalNotes String?
  followUpDate  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  assignedTo   User?       @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId    String?
  adminNotes   AdminNote[]
  followUpTasks FollowUpTask[]

  @@index([email])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([companyId])
  @@index([createdAt])
}

model QuoteRequest {
  id                    String      @id @default(cuid())
  contactPerson         String
  email                 String
  phone                 String?
  productCategory       String?
  currentMaterial       String?
  currentPlasticGrade   String?
  monthlyQuantity       String?
  targetApplication     String?
  strengthRequirement   String?
  foodContactRequired   Boolean?
  colorRequirement      String?
  sustainabilityGoal    String?
  expectedPriceRange    String?
  message               String?
  status                QuoteStatus @default(NEW)
  priority              Priority    @default(MEDIUM)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relations
  assignedTo   User?        @relation("AssignedQuotes", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId    String?
  adminNotes   AdminNote[]
  followUpTasks FollowUpTask[]

  @@index([email])
  @@index([status])
  @@index([assignedToId])
  @@index([companyId])
  @@index([createdAt])
}

model SampleRequest {
  id                    String       @id @default(cuid())
  contactPerson         String
  email                 String
  phone                 String?
  requestedMaterialType String?
  application           String?
  quantity              String?
  deliveryAddress       String?
  courierTracking       String?
  status                SampleStatus @default(REQUESTED)
  remarks               String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  adminNotes    AdminNote[]
  followUpTasks FollowUpTask[]

  @@index([email])
  @@index([status])
  @@index([companyId])
  @@index([createdAt])
}

model CalculatorSubmission {
  id                          String   @id @default(cuid())
  companyName                 String?
  contactPerson               String?
  email                       String?
  phone                       String?
  plasticType                 String?
  currentGrade                String?
  currentQuantity             String?
  limexReplacementPercentage  Float?
  estimatedCostSaving         Float?
  estimatedPlasticReduction   Float?
  estimatedCo2Impact          Float?
  assumptionsUsed             Json?
  convertedToLead             Boolean  @default(false)
  createdAt                   DateTime @default(now())

  // Relations
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  @@index([email])
  @@index([companyId])
  @@index([createdAt])
}

model AdminNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdBy      User          @relation("NoteCreator", fields: [createdById], references: [id])
  createdById    String
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId      String?
  inquiry        Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  inquiryId      String?
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteRequestId String?
  sampleRequest  SampleRequest? @relation(fields: [sampleRequestId], references: [id], onDelete: SetNull)
  sampleRequestId String?
}

model FollowUpTask {
  id          String         @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  status      FollowUpStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  assignedTo      User          @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  assignedToId    String
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId       String?
  inquiry         Inquiry?      @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  inquiryId       String?
  quoteRequest    QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteRequestId  String?
  sampleRequest   SampleRequest? @relation(fields: [sampleRequestId], references: [id], onDelete: SetNull)
  sampleRequestId String?

  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
}

model DocumentAsset {
  id          String           @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileType    String?
  fileSize    Int?
  category    DocumentCategory @default(INTERNAL)
  isPublic    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  uploadedBy   User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  uploadedById String
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId    String?

  @@index([category])
  @@index([companyId])
}

model WebsiteSetting {
  id          String             @id @default(cuid())
  key         String             @unique
  value       String
  type        WebsiteSettingType @default(TEXT)
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  updatedBy   User?   @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
}

model ActivityLog {
  id         String             @id @default(cuid())
  action     String
  entityType ActivityEntityType
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime           @default(now())

  // Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([entityType])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── Infinity Growth OS portal ───────────────────

enum PortalAutomationMode {
  OFF
  DRAFT
  APPROVAL
  AUTO
  LOCKDOWN
}

enum PortalRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IncidentSeverity {
  SEV0
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStage {
  DETECTED
  TRIAGE
  CONTAINED
  INVESTIGATING
  FIXING
  RECOVERING
  RESOLVED
}

/// Single-row global posture (automation mode + emergency stop).
model PortalState {
  id             String               @id @default("global")
  automationMode PortalAutomationMode @default(APPROVAL)
  emergencyStop  Boolean              @default(false)
  updatedById    String?
  updatedAt      DateTime             @updatedAt
}

/// Per-automation enable flag + safety mode (defs live in the frontend registry).
model AutomationConfig {
  id        String               @id
  enabled   Boolean              @default(false)
  mode      PortalAutomationMode @default(APPROVAL)
  updatedAt DateTime             @updatedAt
}

/// Human sign-off queue. AI/automation drafts land here for review.
model ApprovalRequest {
  id           String          @id @default(cuid())
  title        String
  kind         String
  automationId String?
  risk         PortalRiskLevel @default(LOW)
  preview      String
  status       ApprovalStatus  @default(PENDING)
  createdAt    DateTime        @default(now())
  decidedAt    DateTime?

  createdBy   User?   @relation("ApprovalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  decidedBy   User?   @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById String?

  @@index([status])
  @@index([createdAt])
}

/// Saved workflow drafts (trigger → condition → action).
model WorkflowDef {
  id          String   @id @default(cuid())
  name        String
  trigger     String
  condition   String
  action      String
  enabled     Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Security / reliability incidents (SEV0–SEV4 lifecycle).
model PortalIncident {
  id          String           @id @default(cuid())
  title       String
  severity    IncidentSeverity
  playbook    String
  stage       IncidentStage    @default(DETECTED)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  @@index([stage])
  @@index([severity])
  @@index([createdAt])
}

enum SecurityEventKind {
  AUTH_FAILURE
  RATE_LIMITED
  VALIDATION_REJECTED
  LOCKDOWN_BLOCK
}

/// Real security telemetry — failed auth, rate-limit hits, rejected public
/// payloads, lockdown-blocked actions. Powers the CyberShield threat feed.
model SecurityEvent {
  id        String            @id @default(cuid())
  kind      SecurityEventKind
  severity  PortalRiskLevel   @default(LOW)
  path      String
  method    String
  ip        String?
  detail    String?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@index([kind])
}

/// Integration connection state (sandbox/production).
model IntegrationConfig {
  id          String   @id
  connected   Boolean  @default(false)
  environment String   @default("sandbox")
  updatedAt   DateTime @updatedAt
}

/// Per-AI-agent enable flag + safety mode.
model AiAgentConfig {
  id        String               @id
  enabled   Boolean              @default(true)
  mode      PortalAutomationMode @default(DRAFT)
  updatedAt DateTime             @updatedAt
}

/// One real Claude-backed agent run — input, draft output, model, token usage
/// and cost. Powers run history and the AI cost/usage stats.
model AiAgentRun {
  id           String   @id @default(cuid())
  agentId      String
  input        String
  output       String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

/// PIM — LIMEX product records (specs & SEO live in `data`).
model Product {
  id        String   @id @default(cuid())
  name      String
  code      String?
  category  String?
  status    String   @default("DRAFT")
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Inventory & sample stock.
model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  sku           String?
  location      String?
  totalStock    Int      @default(0)
  reservedStock Int      @default(0)
  sampleStock   Int      @default(0)
  reorderPoint  Int      @default(0)
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// CPQ quotations (line items in `items`).
model Quotation {
  id         String    @id @default(cuid())
  number     String?
  customer   String
  leadId     String?
  status     String    @default("DRAFT")
  currency   String    @default("INR")
  subtotal   Float     @default(0)
  gstPct     Float     @default(18)
  transport  Float     @default(0)
  discount   Float     @default(0)
  total      Float     @default(0)
  items      Json?
  validUntil DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

/// Orders converted from quotations.
model Order {
  id            String   @id @default(cuid())
  quotationId   String?
  customer      String
  amount        Float    @default(0)
  status        String   @default("CREATED")
  invoiceNumber String?
  paymentStatus String   @default("UNPAID")
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

/// Marketing campaigns (any channel).
model Campaign {
  id        String    @id @default(cuid())
  name      String
  type      String?
  channel   String?
  status    String    @default("DRAFT")
  budget    Float     @default(0)
  spend     Float     @default(0)
  leads     Int       @default(0)
  data      Json?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

/// Content workflow items: SOCIAL / BLOG / LANDING / KEYWORD.
model ContentItem {
  id           String    @id @default(cuid())
  kind         String
  title        String
  status       String    @default("DRAFT")
  channel      String?
  scheduledFor DateTime?
  body         String?
  data         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([kind])
  @@index([status])
}

/// BugShield reports (manual or auto-captured frontend errors).
model BugReport {
  id        String   @id @default(cuid())
  title     String
  severity  String   @default("LOW")
  status    String   @default("OPEN")
  source    String   @default("MANUAL")
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Automated Google data sync snapshots (GA4, GSC, Ads, Logins).
/// Each row = one sync run. Powers the sync-history timeline in the portal.
model GoogleDataSnapshot {
  id        String   @id @default(cuid())
  status    String   @default("SUCCESS") // SUCCESS | FAILED
  data      Json                          // Full overview payload
  error     String?                       // Error message if sync failed
  duration  Int      @default(0)          // Sync duration in milliseconds
  createdAt DateTime @default(now())

  @@index([createdAt])
}
