# WhiteDot backend environment
DATABASE_URL=postgresql://user:password@localhost:5432/whitedot
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,https://rajbhanderi107-droid.github.io,https://admin.whitedot-limex.in

# Production admin frontend origin:
# FRONTEND_URL=https://rajbhanderi107-droid.github.io

# Initial admin account used by npm run seed
ADMIN_SEED_EMAIL=admin@whitedot.in
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# Google admin sign-in. GOOGLE_CLIENT_ID enables the browser token flow.
# GOOGLE_CLIENT_SECRET is optional for the legacy server-side code flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for password-reset emails (optional).
# If HOST/USER/PASS are unset, reset emails are logged to the server console
# instead of being sent — the reset flow still works for local testing, you just
# read the link from the logs. FRONTEND_URL (above) is used to build the link.
ADMIN_INQUIRY_EMAIL=office@whitedotindia.in
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=White Dot <no-reply@whitedot-limex.in>

# LIMEX Assistant (chat). Provider-agnostic — any OpenAI-compatible endpoint.
# Defaults target Groq's free tier (get a free key at https://console.groq.com).
# If LLM_API_KEY is unset, the chat endpoint returns a graceful "unavailable"
# message instead of erroring — the site still builds and runs without it.
# To switch providers, change LLM_BASE_URL + LLM_MODEL (e.g. Google Gemini's
# OpenAI-compatible endpoint, OpenRouter, etc.) — no code change needed.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
