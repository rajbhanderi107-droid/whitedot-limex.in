{
  "name": "whitedot-limex-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run guard:admin-google && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "backend:dev": "npm --prefix server run dev",
    "backend:build": "npm --prefix server run build",
    "backend:start": "npm --prefix server run start",
    "backend:prisma:generate": "npm --prefix server run prisma:generate",
    "backend:prisma:migrate": "npm --prefix server run prisma:migrate",
    "backend:prisma:migrate:deploy": "npm --prefix server run prisma:migrate:deploy",
    "backend:seed": "npm --prefix server run seed",
    "remove:premium:wd": "node scripts/remove-premium-wd.mjs",
    "remove:continuity:wd": "node scripts/remove-continuity-wd.mjs",
    "remove:aggregation:wd": "node scripts/remove-aggregation-wd.mjs",
    "remove:god:wd": "node scripts/remove-god-wd.mjs",
    "remove:assistant:wd": "node scripts/remove-assistant-wd.mjs",
    "remove:allplan": "node scripts/remove-allplan.mjs",
    "wire:higgsfield:loop": "node scripts/wire-higgsfield-loop.mjs",
    "sync:tbm-news": "node scripts/sync-tbm-news.mjs",
    "guard:admin-google": "node scripts/guard-admin-google.mjs",
    "security:audit": "npm audit && npm --prefix server audit",
    "launch:check": "npm run security:audit && npm run build && npm run backend:build"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@vitejs/plugin-react": "^5.1.1",
    "animejs": "^3.2.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.39.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.562.0",
    "polished": "^4.3.1",
    "postprocessing": "^6.39.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.15.1",
    "three": "^0.181.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "axe-core": "^4.11.4",
    "puppeteer-core": "^25.1.0"
  }
}
